// Benchmark: L-shape with parametric mesh density
// Usage: FreeFem++ benchmark_l_shape.edp -n 20
// Outputs: benchmark_l_shape_<n>.dat, benchmark_l_shape_<n>_timing.dat

include "getARGV.idp"
int n = getARGV("-n", 20);

border b1(t=0, 1) { x = 2*t;   y = 0;     label = 1; }
border b2(t=0, 1) { x = 2;     y = t;     label = 2; }
border b3(t=0, 1) { x = 2-t;   y = 1;     label = 3; }
border b4(t=0, 1) { x = 1;     y = 1+t;   label = 4; }
border b5(t=0, 1) { x = 1-t;   y = 2;     label = 5; }
border b6(t=0, 1) { x = 0;     y = 2-2*t; label = 6; }

// Scale mesh points proportional to edge length.
// R3.5: time the FULL pipeline (mesh generation + assembly + solve).
real t0 = clock();
mesh Th = buildmesh(b1(2*n) + b2(n) + b3(n) + b4(n) + b5(n) + b6(2*n));

fespace Vh(Th, P2);
Vh u, v;

real delta = 0.05;
real xmin = 0.0, xmax = 2.0, ymin = 0.0, ymax = 2.0;
int nx = lround(ceil((xmax - xmin) / delta));
int ny = lround(ceil((ymax - ymin) / delta));

// --- hot_bottom: label 1 = 1.0, others = 0.0 ---
solve hotbottom(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=1.0) + on(2, u=0.0) + on(3, u=0.0)
    + on(4, u=0.0) + on(5, u=0.0) + on(6, u=0.0);
real elapsed = clock() - t0;

{
    ofstream f("benchmark_l_shape_" + n + ".dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}

{
    ofstream f("benchmark_l_shape_" + n + "_timing.dat");
    f.scientific;
    f << elapsed << endl;
}
