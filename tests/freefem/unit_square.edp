// Unit square: vertices [0,0],[1,0],[1,1],[0,1]
// Edge 0 -> label 1 (bottom), Edge 1 -> label 2 (right),
// Edge 2 -> label 3 (top), Edge 3 -> label 4 (left)

int n = 200; // ~200 points per unit length

border bottom(t=0, 1) { x = t;   y = 0;   label = 1; }
border right(t=0, 1)  { x = 1;   y = t;   label = 2; }
border top(t=0, 1)    { x = 1-t; y = 1;   label = 3; }
border left(t=0, 1)   { x = 0;   y = 1-t; label = 4; }

mesh Th = buildmesh(bottom(n) + right(n) + top(n) + left(n));

fespace Vh(Th, P2);
Vh u, v;

// Grid parameters matching Volkov solver (delta = 0.05)
real delta = 0.05;
real xmin = 0.0, xmax = 1.0, ymin = 0.0, ymax = 1.0;
int nx = lround(ceil((xmax - xmin) / delta));
int ny = lround(ceil((ymax - ymin) / delta));

// --- hot_bottom: label 1 = 1.0, others = 0.0 ---
solve hotbottom(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=1.0) + on(2, u=0.0) + on(3, u=0.0) + on(4, u=0.0);

{
    ofstream f("unit_square_hot_bottom.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}

// --- hot_right: label 2 = 1.0, others = 0.0 ---
solve hotright(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=0.0) + on(2, u=1.0) + on(3, u=0.0) + on(4, u=0.0);

{
    ofstream f("unit_square_hot_right.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}

// --- mixed: label 1 = 1.0, label 2 = 0.5, others = 0.0 ---
solve mixed(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=1.0) + on(2, u=0.5) + on(3, u=0.0) + on(4, u=0.0);

{
    ofstream f("unit_square_mixed.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}
