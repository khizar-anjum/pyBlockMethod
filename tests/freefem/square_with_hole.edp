// Square with hole
// Main polygon: [0,0],[1,0],[1,1],[0,1] (labels 1-4)
// Hole: [0.3,0.3]-[0.7,0.3]-[0.7,0.7]-[0.3,0.7] (labels 5-8, all u=0)

int n = 200;  // ~200 points per unit length for outer boundary
int nh = 80;  // ~200 pts/unit * 0.4 side length for hole

// Outer boundary (counterclockwise)
border bottom(t=0, 1) { x = t;   y = 0;   label = 1; }
border right(t=0, 1)  { x = 1;   y = t;   label = 2; }
border top(t=0, 1)    { x = 1-t; y = 1;   label = 3; }
border left(t=0, 1)   { x = 0;   y = 1-t; label = 4; }

// Hole boundary (counterclockwise, negative counts to create hole)
border h1(t=0, 1) { x = 0.3 + 0.4*t; y = 0.3;         label = 5; }
border h2(t=0, 1) { x = 0.7;         y = 0.3 + 0.4*t; label = 6; }
border h3(t=0, 1) { x = 0.7 - 0.4*t; y = 0.7;         label = 7; }
border h4(t=0, 1) { x = 0.3;         y = 0.7 - 0.4*t; label = 8; }

mesh Th = buildmesh(bottom(n) + right(n) + top(n) + left(n)
                  + h1(-nh) + h2(-nh) + h3(-nh) + h4(-nh));

fespace Vh(Th, P2);
Vh u, v;

// Grid parameters matching Volkov solver (delta = 0.05)
real delta = 0.05;
real xmin = 0.0, xmax = 1.0, ymin = 0.0, ymax = 1.0;
int nx = lround(ceil((xmax - xmin) / delta));
int ny = lround(ceil((ymax - ymin) / delta));

// --- hot_bottom: label 1 = 1.0, all others = 0.0 ---
solve hotbottom(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=1.0) + on(2, u=0.0) + on(3, u=0.0) + on(4, u=0.0)
    + on(5, u=0.0) + on(6, u=0.0) + on(7, u=0.0) + on(8, u=0.0);

{
    ofstream f("square_with_hole_hot_bottom.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}

// --- hot_right: label 2 = 1.0, all others = 0.0 ---
solve hotright(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=0.0) + on(2, u=1.0) + on(3, u=0.0) + on(4, u=0.0)
    + on(5, u=0.0) + on(6, u=0.0) + on(7, u=0.0) + on(8, u=0.0);

{
    ofstream f("square_with_hole_hot_right.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}

// --- mixed: label 1 = 1.0, label 2 = 0.5, all others = 0.0 ---
solve mixed(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v))
    + on(1, u=1.0) + on(2, u=0.5) + on(3, u=0.0) + on(4, u=0.0)
    + on(5, u=0.0) + on(6, u=0.0) + on(7, u=0.0) + on(8, u=0.0);

{
    ofstream f("square_with_hole_mixed.dat");
    f.scientific;
    for (int j = 0; j < ny; j++)
        for (int i = 0; i < nx; i++) {
            real px = xmin + 0.5*delta + i*(xmax - xmin)/(nx - 1.0);
            real py = ymin + 0.5*delta + j*(ymax - ymin)/(ny - 1.0);
            f << px << " " << py << " " << u(px, py) << endl;
        }
}
